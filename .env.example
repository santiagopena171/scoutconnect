# Configuración de Supabase - ScoutConnect
# ⚠️ Copia este archivo como .env y rellena con tus credenciales reales

# URL del proyecto Supabase
# Obtén este valor de: https://supabase.com/dashboard → Settings → API
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública (anon key) de Supabase
# Obtén este valor de: https://supabase.com/dashboard → Settings → API
SUPABASE_ANON_KEY=tu_clave_publica_aqui
